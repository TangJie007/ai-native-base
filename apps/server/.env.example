# ===== 业务数据库（MySQL，见 PRD 8.1） =====
DATABASE_URL="mysql://root:password@127.0.0.1:3306/specforge"

# ===== 服务 =====
PORT=3000
JWT_SECRET="specforge-dev-secret-change-me"
JWT_EXPIRES_IN="7d"

# ===== 向量存储（SQLite，Node 内置 node:sqlite，见 PRD 8.1） =====
VECTOR_DB_PATH="./data/vectors.db"

# ===== LLM 适配器 =====
# mock | openai-compatible
LLM_PROVIDER="mock"
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL_HIGH="gpt-4.1"
LLM_MODEL_VALUE="deepseek-v3"
LLM_MODEL_MEDIUM="claude-sonnet-4"

# ===== 沙箱适配器 =====
# mock | e2b | docker
SANDBOX_PROVIDER="mock"

# ===== 执行参数（见 PRD 4.5 / 4.6） =====
PIPELINE_CONCURRENCY=3
MAX_FIX_ROUNDS=3
