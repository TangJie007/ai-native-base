# ===== 业务数据库（MySQL，见 PRD 8.1） =====
DATABASE_URL="mysql://root:password@127.0.0.1:3306/specforge"

# ===== 服务 =====
PORT=3000
JWT_SECRET="specforge-dev-secret-change-me"
JWT_EXPIRES_IN="7d"
# 允许跨域的来源，逗号分隔；留空则回退开发默认值 http://localhost:5173,http://localhost:5174
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# ===== 向量存储（SQLite，Node 内置 node:sqlite，见 PRD 8.1） =====
VECTOR_DB_PATH="./data/vectors.db"

# ===== LLM 适配器 =====
# mock | openai（亦兼容 openai-compatible / openai_compatible / compatible 写法）
LLM_PROVIDER="mock"
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL_HIGH="gpt-4o"
LLM_MODEL_VALUE="gpt-4o-mini"
LLM_MODEL_MEDIUM="gpt-4o-mini"
# 主模型不可用时的降级模型，留空表示不启用降级
LLM_FALLBACK_MODEL=""
# 单次 LLM 请求超时（毫秒）
LLM_TIMEOUT_MS=60000
# LLM 调用重试次数
LLM_MAX_RETRIES=1

# ===== 沙箱适配器 =====
# mock | e2b | docker（P0 仅实现 mock）
SANDBOX_PROVIDER="mock"

# ===== 执行参数（见 PRD 4.5 / 4.6） =====
# 默认并发度
PIPELINE_CONCURRENCY=3
# 单条目最大修复轮次
MAX_FIX_ROUNDS=3
